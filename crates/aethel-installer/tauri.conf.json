{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aethel Setup",
  "version": "1.0.0-rc.4",
  "identifier": "org.aethelis.installer",
  "build": {
    "beforeBuildCommand": "npm run build:installer",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aethel Launcher Setup",
        "width": 720,
        "height": 520,
        "resizable": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
